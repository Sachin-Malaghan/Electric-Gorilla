# Copy to .env and edit. Everything is optional; with nothing set the studio runs fully offline.

# --- Agents -----------------------------------------------------------------
# scripted  = deterministic demo/test provider (free, only knows the health-component milestone)
# anthropic = real agents (needs ANTHROPIC_API_KEY, or an `ant auth login` profile)
SHUNYA_MODEL_PROVIDER=scripted
# ANTHROPIC_API_KEY=
# Models per routing tier (spec 33). By default all tiers use one model at low/medium/high effort.
# SHUNYA_MODEL_FAST=claude-opus-5-5
# SHUNYA_MODEL_STANDARD=claude-opus-5-5
# SHUNYA_MODEL_STRONG=claude-opus-5-5
# Server-side fallback when a safety classifier declines a request (Claude API only).
# SHUNYA_MODEL_FALLBACKS=true

# --- Storage ----------------------------------------------------------------
# Default: SQLite at data/shunya.db and an in-process event bus.
# DATABASE_URL=postgresql+psycopg://shunya:shunya@localhost:5432/shunya
# REDIS_URL=redis://localhost:6379/0
# SHUNYA_DATA_DIR=
# Keep this path SHORT on Windows (Unreal build output adds ~150 characters).
# SHUNYA_WORKSPACE_DIR=

# --- Unreal -----------------------------------------------------------------
# Auto-detected under C:\Program Files\Epic Games\UE_5.x when unset.
# SHUNYA_ENGINE_ROOT=C:\Program Files\Epic Games\UE_5.8
# SHUNYA_DISABLE_UNREAL=false
# SHUNYA_BRIDGE_URL=http://127.0.0.1:30777
# SHUNYA_BRIDGE_TOKEN=shunya-dev-token

# --- Server / access --------------------------------------------------------
# Set a long random value. Every API call and the live stream then need it; the office page asks once.
# Required to listen on anything other than 127.0.0.1.
# SHUNYA_API_TOKEN=
# SHUNYA_HOST=127.0.0.1
# SHUNYA_PORT=8400
# SHUNYA_LOG_LEVEL=INFO
# SHUNYA_MAX_CONCURRENT_TASKS=4
# SHUNYA_MAX_ACTIVE_FEATURES=3
# Empty = you approve every merge. LOW = policy approves merges whose computed risk is LOW.
# Packaged builds always need your approval.
# SHUNYA_AUTO_APPROVE_MAX_RISK=

# --- Demo ---------------------------------------------------------------------
# Scripted provider: seconds of "thinking" per step so the office is watchable (serve defaults to 0.9).
# SHUNYA_DEMO_STEP_DELAY=0.9
# Scripted provider: make the programmer's first attempt contain a compile error.
# SHUNYA_DEMO_INJECT_ERROR=true
